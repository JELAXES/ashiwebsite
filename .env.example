# Server-only — never expose this to the client or commit a real key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# MongoDB connection string. On Railway, set this to the MongoDB service's MONGO_URL
# (Railway private networking hostname — only resolvable between services in the
# same Railway project, not from a local machine).
MONGODB_URI=

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET=

# Password for the /admin panel on first login only. The admin panel stores its
# own password hash in the database after that — changing it there doesn't
# touch this variable again. Only matters if no admin password has been set yet.
ADMIN_DEFAULT_PASSWORD=
